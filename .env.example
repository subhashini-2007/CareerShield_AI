# ==============================================================================
# CareerShield AI — Unified Production Environment Configuration Template
# ==============================================================================
# Tagline: Verify Opportunities. Protect Futures.
# Monthly Cost: ₹0.00 (Vercel Frontend + Render Backend + Neon PostgreSQL)
#
# DO NOT commit real secrets, database passwords, or private keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (Render Web Service)
# ------------------------------------------------------------------------------

# Application Metadata
APP_NAME="CareerShield AI"
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security (MANDATORY: Minimum 32 characters in production)
# Generate a fresh 48-char key using: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your_generated_secret_key_minimum_32_characters_here

# Allowed CORS Origins (Include your production Vercel frontend URL)
# Format: JSON array string or comma-separated URLs
CORS_ORIGINS=["https://careershield-ai.vercel.app","http://localhost:3000"]
# Or comma-separated:
# CORS_ORIGINS=https://careershield-ai.vercel.app,http://localhost:3000

# Database Connection (Neon Serverless PostgreSQL Free Tier)
# Copy the POOLED connection string from the Neon Console:
# Format: postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Machine Learning Artifacts Relative Path
MODEL_ARTIFACTS_DIR=artifacts/models

# Privacy & Audit Settings (Hashes client IPs before persisting)
ANONYMIZE_IPS=true


# ------------------------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (Vercel Project Dashboard)
# ------------------------------------------------------------------------------

# Backend API Endpoint URL (Points to your deployed Render service)
NEXT_PUBLIC_API_URL=https://careershield-api.onrender.com/api/v1

# Branding & Metadata
NEXT_PUBLIC_APP_NAME="CareerShield AI"
NEXT_PUBLIC_TAGLINE="Verify Opportunities. Protect Futures."
