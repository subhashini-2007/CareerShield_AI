# ==============================================================================
# CareerShield AI — Backend Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and customize it for your local environment:
#   cp .env.example .env
#
# DO NOT commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Application Settings
APP_NAME="CareerShield AI"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Security
# In production, SECRET_KEY MUST be a strong, randomly generated string (min 32 chars).
# In development, if left empty, an ephemeral random key will be generated with a warning.
SECRET_KEY=

# Allowed CORS Origins (JSON array format standard for Pydantic BaseSettings, or comma-separated string)
# Pydantic standard JSON array format:
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Alternative comma-separated format also supported by custom validator:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# Database Configuration (PostgreSQL is the intended primary database)
# Provide your PostgreSQL connection string:
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careershield_db

# Optional: To explicitly use SQLite for local development without PostgreSQL, uncomment:
# DATABASE_URL=sqlite:///./careershield.db
# Note: SQLite will ONLY be used if explicitly configured above.
# The system will NEVER silently fallback from PostgreSQL to SQLite on connection errors.

# Machine Learning Artifacts Directory
MODEL_ARTIFACTS_DIR=artifacts/models
